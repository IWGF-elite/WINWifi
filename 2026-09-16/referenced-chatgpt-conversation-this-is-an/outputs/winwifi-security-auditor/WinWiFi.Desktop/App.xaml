<Application x:Class="WinWiFi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Modern Windows Dark Palette -->
        <Color x:Key="BgDark">#0F1115</Color>
        <Color x:Key="SurfaceDark">#161920</Color>
        <Color x:Key="BorderDark">#252936</Color>
        <Color x:Key="AccentBlue">#3B82F6</Color>
        <Color x:Key="TextLight">#E2E8F0</Color>
        <Color x:Key="TextMuted">#94A3B8</Color>

        <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource BgDark}"/>
        <SolidColorBrush x:Key="BrushSurfaceDark" Color="{StaticResource SurfaceDark}"/>
        <SolidColorBrush x:Key="BrushBorderDark" Color="{StaticResource BorderDark}"/>
        <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource AccentBlue}"/>
        <SolidColorBrush x:Key="BrushTextLight" Color="{StaticResource TextLight}"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2D3545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#161920"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#252936"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#222633"/>
            <Setter Property="RowBackground" Value="#161920"/>
            <Setter Property="AlternatingRowBackground" Value="#1A1D26"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#252936"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Application.Resources>
</Application>
