<Window x:Class="WinWiFi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WinWiFi Security Auditor"
        Height="900" Width="1440" MinHeight="640" MinWidth="1000"
        Background="#0b0d11"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#0b0d11">
        <wv2:WebView2 x:Name="Dashboard" />
        <Border x:Name="StartupError" Background="#111722" Visibility="Collapsed" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
                <TextBlock Text="WinWiFi could not open its dashboard" Foreground="#f8fafc" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock x:Name="StartupErrorMessage" TextWrapping="Wrap" Foreground="#cbd5e1" FontSize="14" />
                <Button x:Name="InstallWebView2Button" Content="Install WebView2 Runtime" Click="OnInstallWebView2Click"
                        Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="14,8"
                        Background="#2563eb" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
