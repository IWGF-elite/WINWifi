<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\WinWiFi.ico</ApplicationIcon>
    <AssemblyName>WinWiFi</AssemblyName>
    <RootNamespace>WinWiFi</RootNamespace>
    <Version>3.0.0</Version>
    <Company>Airgorah Security</Company>
    <Product>WinWiFi Security Auditor</Product>
    <Description>Windows-Native 802.11 Wireless Security Auditor, Spectrum Analyzer and PCAP/PCAPNG Dissector</Description>
    <Platforms>AnyCPU;x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartupObject>WinWiFi.Program</StartupObject>
    <DefineConstants>$(DefineConstants);WINDOWS_DESKTOP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Oui\*.txt" />
    <!-- The executable icon is set above; WPF also needs this as a resource
         for MainWindow.Icon when the app is launched from Explorer. -->
    <Resource Include="Assets\WinWiFi.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM Toolkit & Dependency Injection -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    
    <!-- SQLite Relational Storage -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.4" />
    <PackageReference Include="Dapper" Version="2.1.35" />

    <!-- JSON & Cryptography -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- Keep the React dashboard beside every desktop build, not just the
       published release. The local bridge serves this folder to WebView2. -->
  <ItemGroup Condition="Exists('..\\dist\\index.html')">
    <Content Include="..\\dist\\**\\*">
      <Link>dashboard\\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
